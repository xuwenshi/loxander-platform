# Loxander 平台环境变量示例
#
# 用法：复制成 .env（已被 .gitignore 忽略），填入真实值。
# 提交前确认：.env / .env*.local 都在 .gitignore 里，绝不会被提交。

# ---------------------------------------------------------------------------
# 内容源开关（P2 引入，P3 起公开站默认读库）
# ---------------------------------------------------------------------------
# markdown = 读 content/*.md（当前线上行为，P2 期间的默认值）
# db       = 读 PostgreSQL 的 entries 表
# 非法值会直接报错，不会静默回退 —— 静默回退会让「以为在测库、其实在读文件」。
CONTENT_SOURCE=markdown

# ---------------------------------------------------------------------------
# 数据库连接串
# ---------------------------------------------------------------------------
# Neon：
#   控制台 https://console.neon.tech → 选中项目 → Dashboard → Connection string
#   → 复制 "postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require"
#
# 本地 Postgres：
#   postgresql://postgres:<password>@127.0.0.1:5432/loxander
#
# 注意：Neon 的连接串必须带 sslmode=require，否则 postgres.js 会明文连上去被拒。
DATABASE_URL=

# ---------------------------------------------------------------------------
# 站点基础地址（sitemap / RSS / 绝对 URL 用）
# ---------------------------------------------------------------------------
# 代码真正读的是 NEXT_PUBLIC_SITE_URL（apps/web/src/lib/site.ts:68），
# 缺失时回退到内置默认值 https://loxander.is-a.dev。
#
# 注意：P3 之前这里登记的名字是 SITE_URL，但**没有任何代码读它** ——
# 配了 SITE_URL 而没配 NEXT_PUBLIC_SITE_URL 时，站点会静默继续用内置默认地址。
# 后台设置页（/admin/settings）会把这个状态标成「只配了旧名」并给出提示。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 兼容旧名：仅在 NEXT_PUBLIC_SITE_URL 缺失时被 /admin/settings 读取用于提示，
# 不参与任何实际 URL 拼接。新项目不要配这一项。
# SITE_URL=

# ---------------------------------------------------------------------------
# 认证（P4 引入，Auth.js v5 + GitHub OAuth）
# ---------------------------------------------------------------------------
# AUTH_SECRET：会话与 CSRF token 的签名密钥。
#   生成：openssl rand -base64 32
#   生产环境（NODE_ENV=production）**必填**，缺失时 Auth.js 直接抛 MissingSecretError。
#   开发环境缺失会降级为「每次重启随机生成」，表现为刷新页面就掉登录。
# AUTH_SECRET=
#
# GitHub OAuth App：
#   https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL               = 你的站点地址
#   Authorization callback URL = <站点地址>/api/auth/callback/github
#   本地开发填 http://localhost:3000/api/auth/callback/github
#   注意：回调地址必须逐字符一致（含结尾斜杠），否则 GitHub 返回 redirect_uri_mismatch。
# Auth.js 会自动读取 AUTH_GITHUB_ID / AUTH_GITHUB_SECRET，不需要在代码里再传一遍。
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
#
# 管理员白名单：允许登录后台的 GitHub 账号 login（不是邮箱、不是显示名）。
#   多个用逗号或空格分隔；大小写不敏感。
#   留空 = 任何人都进不来（fail-closed），不是「谁都能进」。
# ADMIN_GITHUB_LOGIN=
#
# 可选：反向代理 / 自定义域名下显式声明站点地址（Auth.js 用它拼回调 URL）。
# AUTH_URL=https://example.com

# ---------------------------------------------------------------------------
# 媒体存储（P5 引入，Vercel Blob）
# ---------------------------------------------------------------------------
# 配了 BLOB_READ_WRITE_TOKEN → 上传的图片进 Blob，
#   返回 https://<store>.public.blob.vercel-storage.com/media/...
# 没配 → 降级写到 apps/web/public/media/（仅本地开发可用；
#   Vercel 的文件系统是只读的，生产环境上传会直接失败）。
#
# 获取方式：
#   Vercel 控制台 → 项目 → Storage → Create → Blob → 创建后在 Store 的
#   ".env" 标签页复制 BLOB_READ_WRITE_TOKEN；或本地执行 `vercel env pull`。
#
# 注意：这个 token 是读写权限 —— 泄露等于别人可以往你的存储灌任意文件、
#   也可以删你的图。方案 §13.5 要求定期轮换，且只在 Vercel 环境变量里配置，
#   不要写进任何会被提交的文件。
# BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# 健康检查限流（P5 引入，全部可选）
# ---------------------------------------------------------------------------
# 默认 60 秒 / 30 次，超限返回 429 + Retry-After。
#
# HEALTH_RATE_LIMIT_BYPASS_TOKEN：给监控系统留的白名单。
#   配了这个变量后，请求头带 `x-health-token: <同一个值>` 的调用不计入限流。
#   **不配时任何人都不享受豁免**（fail-closed），不会因为「忘了配」就变成不限流。
#   为什么要留门：监控系统与攻击者常共享出口 IP，硬限流会把监控自己限死，
#   于是「站点挂了」和「监控被限流了」变成同一个现象。
# HEALTH_RATE_LIMIT_BYPASS_TOKEN=
#
# HEALTH_RATE_LIMIT_PER_MINUTE：覆盖每分钟配额。非法值（非正整数）静默退回 30。
# HEALTH_RATE_LIMIT_PER_MINUTE=30

# ---------------------------------------------------------------------------
# 版本号（健康检查 / 后台设置页展示用，全部可选）
# ---------------------------------------------------------------------------
# Vercel 部署时自动注入 VERCEL_GIT_COMMIT_SHA，不需要手配（列在这里只是为了
# 让「代码读了哪些变量」能一眼对全，值由平台注入）。
# VERCEL_GIT_COMMIT_SHA=
#
# 自建 / CI 环境想在看板里显示版本时，用 GIT_COMMIT_SHA 塞进去：
#   GIT_COMMIT_SHA=$(git rev-parse --short HEAD)
# 两者都没配时，健康检查的 version 字段返回 "dev"。
# GIT_COMMIT_SHA=
