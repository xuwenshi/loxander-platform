# 依赖
node_modules/

# Next.js
.next/
out/
next-env.d.ts

# Electron / electron-vite / electron-builder
release/
dist/
dist-electron/

# TypeScript
*.tsbuildinfo

# 环境变量
.env
.env*.local

# 测试与覆盖率
coverage/

# 数据库备份
# backups/ 里是 `npm run db:backup` 导出的全库 JSON，含真实内容数据。
# 内容本身已经通过 Markdown 源和迁移进版本库了，备份文件是「出事时捞回来」的
# 运行时产物，不该进版本库（会随每次备份膨胀，且可能含后台写入的草稿）。
# 需要长期留存的话应该放对象存储，不是 git。
backups/

# 临时探针与浏览器调试数据
# .tmp-* 是本机沙箱下跑浏览器验收/探针时产生的临时文件。
# .tmp-edge-cdp/ 是 Edge 的用户数据目录，进程存活期间其中的文件被独占
# （lockfile、Nested\campaign_history 等），Windows 下删不掉；
# 它只在本机存在，绝不能进版本库，所以用忽略规则兜住而不是靠删除。
.tmp-*
.mutbak*

# 本地缓存与日志
.npmcache/
.esbuild-tmp/
*.log
npm-debug.log*

# 编辑器与系统
.DS_Store
.idea/
.vscode/

# Vercel CLI 的本地链接信息（含 projectId / orgId，不是秘密但每台机器不同）
.vercel
# 刻意不写 `.env*`：那会把 `apps/web/.env.example`（要进版本库的模板）也忽略掉。
# 真正的密钥文件由上面的 `.env` 与 `.env*.local` 覆盖，Vercel CLI 生成的
# 根目录 `.env.local`（只含 VERCEL_OIDC_TOKEN）也落在 `.env*.local` 里。
.env.local
.env.*.local
