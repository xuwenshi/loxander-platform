{
  "name": "loxander-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Loxander 动态内容平台 monorepo（公开站点、后台、可选桌面端与共享包）",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:web",
    "build:web": "npm run build -w apps/web",
    "build:desktop": "npm run build -w apps/desktop",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:web": "npm run typecheck -w apps/web",
    "typecheck:desktop": "npm run typecheck -w apps/desktop",
    "test": "npm run test --workspaces --if-present"
  },
  "overrides": {
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
